        "jsCode": "const body = $input.first().json.body || $input.first().json;\nconst errors = [];\n\nif (!body.org_name || typeof body.org_name !== 'string' || body.org_name.trim() === '') {\n  errors.push('org_name is required');\n}\nif (!body.contract_id || typeof body.contract_id !== 'string' || body.contract_id.trim() === '') {\n  errors.push('contract_id is required');\n}\nif (!body.title || typeof body.title !== 'string' || body.title.trim() === '') {\n  errors.push('title is required');\n}\n\nconst validRiskLevels = ['HIGH', 'MEDIUM', 'LOW'];\nif (!body.risk_level) {\n  errors.push('risk_level is required');\n} else if (!validRiskLevels.includes(body.risk_level.toUpperCase())) {\n  errors.push(`risk_level must be one of: ${validRiskLevels.join(', ')}`);\n}\n\nreturn [{\n  json: {\n    valid: errors.length === 0,\n    errors,\n    body: {\n      ...body,\n      risk_level: body.risk_level ? body.risk_level.toUpperCase() : body.risk_level\n    }\n  }\n}];"
      },
