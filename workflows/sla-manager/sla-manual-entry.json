    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body || $input.first().json;\nconst errors = [];\n\nif (!body.org_name || typeof body.org_name !== 'string' || body.org_name.trim() === '') {\n  errors.push('org_name is required');\n}\nif (!body.contract_id || typeof body.contract_id !== 'string' || body.contract_id.trim() === '') {\n  errors.push('contract_id is required');\n}\n\nconst validPriorities = ['P1-Critical', 'P2-High', 'P3-Medium', 'P4-Low'];\nif (!body.priority_level) {\n  errors.push('priority_level is required');\n} else if (!validPriorities.includes(body.priority_level)) {\n  errors.push(`priority_level must be one of: ${validPriorities.join(', ')}`);\n}\n\nreturn [{\n  json: {\n    valid: errors.length === 0,\n    errors,\n    body\n  }\n}];"
      },
      "id": "node-validate-sla",
      "name": "Validate SLA Input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        304
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond-sla-valid",
              "leftValue": "={{ $json.valid }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
