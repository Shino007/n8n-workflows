                    }
                  },
                  {
                    "text": "Cancel",
                    "additionalFields": {
                      "url": "={{ $execution.resumeUrl }}{{ $execution.resumeUrl.includes('?') ? '&' : '?' }}action=cancel&token={{ $json.confirmToken }}"
                    }
                  }
                ]
              }
            }
          ]
        },
        "additionalFields": {
          "parse_mode": "Markdown",
          "appendAttribution": false,
          "caption": "=*Set this as the featured image?*\n\nPost: {{ $json.postTitle }}\nStatus: {{ $json.postStatus }}\nSearch term: {{ $json.query }}\n\nThe current image stays in the media library either way."
        }
      },
      "onError": "continueRegularOutput",
      "webhookId": "e4ac3e06-2bff-4ce9-bdfd-16a5255671e9",
