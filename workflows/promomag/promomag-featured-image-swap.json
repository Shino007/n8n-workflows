    {
      "id": "136204f9-4fac-48b9-a042-ee7efea6d11f",
      "name": "Confirm Router",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1760,
        -120
      ],
      "parameters": {
        "jsCode": "const sd = $getWorkflowStaticData('global');\nconst cand = $('Prepare Candidate').first().json;\nconst chatId = cand.chatId;\nconst q = ($input.first().json || {}).query || {};\n\nconst expected = cand.confirmToken || sd['imageSwapToken_' + chatId] || '';\nconst tokenOk = !!expected && String(q.token || '') === expected;\n\n// Single use either way, so a replayed link cannot swap the image a second time.\ndelete sd['imageSwapToken_' + chatId];\n\nconst action = tokenOk ? String(q.action || '').toLowerCase() : '';\nconst apply = action === 'apply';\n\nreturn [{ json: Object.assign({}, cand, { action, apply, tokenOk }) }];"
      }
    },
