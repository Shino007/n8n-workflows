    {
      "id": "8cbf665e-a074-4738-aa6c-c8680f851b55",
      "name": "Normalise Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "jsCode": "const j = $input.first().json || {};\nconst chatId = j.chatId;\n// The caller always passes chatId. Without it there is nobody to show the preview to, so fail\n// loudly (the error workflow alerts) rather than guess a chat.\nif (!chatId) throw new Error('Image Swap called without chatId');\n\nconst raw = String(j.query || '').trim();\nconst cleaned = raw.replace(/[^a-zA-Z0-9 ]/g, ' ').replace(/\\s+/g, ' ').trim();\n\n// Pixabay ANDs its search terms, so a long phrase returns nothing and the run dead-ends\n// on an empty hits array. Three words is the ceiling that reliably returns results.\nconst words = cleaned.split(' ').filter(w => w.length > 1).slice(0, 3);\nconst query = words.join(' ');\n\nif (!query) {\n  return [{ json: { chatId, query: '', valid: false, reason: 'No search term given. Send: image <search term>' } }];\n}\n\nreturn [{ json: { chatId, query, valid: true, reason: '' } }];"
      }
    },
    {
      "id": "a9c1c58c-feb8-4338-baf0-ef628ea2698c",
      "name": "Fetch Latest Post",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "method": "GET",
        "url": "https://promomag.co.uk/wp-json/wp/v2/posts?per_page=1&orderby=date&order=desc&status=publish,draft&_fields=id,title,link,featured_media,status",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBasicAuth",
        "options": {
          "timeout": 15000
        }
      },
      "onError": "continueRegularOutput",
      "credentials": {
        "httpBasicAuth": {
          "id": "jkmcRGFCJbTsbiYb",
          "name": "n8n PromoMag"
        }
      }
    },
    {
      "id": "6fe04413-c059-4002-9f8e-6a1959511811",
      "name": "Fetch Pixabay",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        0
      ],
      "parameters": {
        "method": "GET",
        "url": "=https://pixabay.com/api/?key=REDACTED_API_KEY&q={{ encodeURIComponent($('Normalise Request').item.json.query) }}&image_type=photo&orientation=horizontal&min_width=1280&safesearch=true&per_page=10&order=popular",
        "options": {
          "timeout": 15000
        }
      },
      "onError": "continueRegularOutput",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "id": "17f214e7-1801-4b4f-93f4-0f0b7e90cddc",
      "name": "Prepare Candidate",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        0
      ],
      "parameters": {
        "jsCode": "const sd = $getWorkflowStaticData('global');\nconst req = $('Normalise Request').first().json;\nconst chatId = req.chatId;\n\nif (!req.valid) {\n  return [{ json: { chatId, ok: false, reason: req.reason } }];\n}\n\nlet post = {};\ntry { post = $('Fetch Latest Post').first().json || {}; } catch (e) { post = {}; }\nconst postId = post.id || 0;\nconst postTitle = (post.title && post.title.rendered) ? post.title.rendered : '';\nconst postStatus = post.status || '';\n\nif (!postId) {\n  return [{ json: { chatId, ok: false, reason: 'Could not read the most recent post from WordPress.' } }];\n}\n\nconst hits = ($input.first().json && $input.first().json.hits) ? $input.first().json.hits : [];\nconst hit = hits.find(h => h.largeImageURL || h.webformatURL);\n\nif (!hit) {\n  return [{ json: { chatId, ok: false, reason: 'No Pixabay results for \\\"' + req.query + '\\\". Try a broader term.' } }];\n}\n\n// The resume URL carries no authentication of its own, so anyone holding the link could\n// change the image. Mint a single-use token and require it on resume, the same way the\n// scheduled approval path does.\nconst confirmToken = Array.from({length:4},()=>Math.random().toString(36).slice(2,10)).join('');\nsd['imageSwapToken_' + chatId] = confirmToken;\n\nreturn [{ json: {\n  chatId,\n  ok: true,\n  query: req.query,\n  postId,\n  postTitle,\n  postStatus,\n  previousMediaId: post.featured_media || 0,\n  imageUrl: hit.largeImageURL || hit.webformatURL,\n  confirmToken\n} }];"
      }
    },
